# NWPH OS configuration. Copy to .env and adjust. Never commit .env.

# Interface and port. Keep 127.0.0.1 unless the app sits behind an HTTPS reverse proxy.
HOST=127.0.0.1
PORT=4400

# development | production. Production forces Secure cookies and requires HTTPS.
NODE_ENV=development

# SQLite database file and private upload directory (both created if missing,
# both git-ignored). Uploads are never served from a public path.
DATABASE_PATH=./data/nwph-os.db
UPLOAD_DIR=./data/uploads

# Maximum size of one uploaded document, in megabytes.
MAX_UPLOAD_MB=20

# Session lifetime. Idle sessions expire sooner than the absolute limit.
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# Set to true only when TLS terminates in front of the app (reverse proxy).
# Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false

# Set to true only behind a reverse proxy you trust (your own, or GitHub
# Codespaces), so X-Forwarded-For is used for login throttling and
# X-Forwarded-Host for the cross-site request check.
TRUST_PROXY=false

# One-time token for creating the first owner account through /setup.
# If unset while no users exist, a random token is generated and printed to the
# server console on start. Alternatively use: npm run user:create
# SETUP_TOKEN=
